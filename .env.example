# Server only. Put your real key in .env.local. Never use NEXT_PUBLIC_ for keys.
GROQ_API_KEY=
GROQ_VERIFIER_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_MS=60000

# Local Chroma HTTP server; remote hosts are deliberately rejected.
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8000
CHROMA_COLLECTION=rag_hf_minilm_v1

# Hugging Face dataset viewer /rows configuration.
HF_DATASET=rajpurkar/squad
HF_CONFIG=plain_text
HF_SPLIT=train
HF_TEXT_FIELD=context
HF_TITLE_FIELD=title
HF_MAX_ROWS=1000
HF_START_OFFSET=0
HF_BATCH_SIZE=32
HF_CHUNK_SIZE=800
HF_CHUNK_OVERLAP=120
# Optional token for datasets requiring authentication.
HF_TOKEN=
