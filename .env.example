# Server-only settings. Copy to .env.local and set GROQ_API_KEY. Never use NEXT_PUBLIC_ for keys.

# --- Groq (all LLM inference) ---
GROQ_API_KEY=
# Llama 3.x 70B models are retired on Groq; gpt-oss-120b is the default for both roles.
# GROQ_MODEL sets both at once; the specific settings below override it.
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_CHECKER_MODEL=openai/gpt-oss-120b
# gpt-oss reasoning effort: low (fastest), medium, or high.
GROQ_REASONING_EFFORT=low
# Per-attempt timeout and retry count (the SDK retries timeouts, 429s, and 5xx).
GROQ_TIMEOUT_MS=60000
GROQ_MAX_RETRIES=2

# --- Local ChromaDB (npm run chroma:start serves it on this host and port) ---
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_DOCUMENTS_COLLECTION=uploaded_documents
CHROMA_HF_COLLECTION=hf_test_contexts

# --- Hugging Face (optional token for gated or private datasets) ---
HF_TOKEN=
